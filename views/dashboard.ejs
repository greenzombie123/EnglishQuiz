<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/dashboard.css">
    <script type="importmap">
        {
             "imports": {
                "lit": "/node_modules/lit/index.js",
                "lit/": "/node_modules/lit/",
                "lit-html": "/node_modules/lit-html/lit-html.js",
                "lit-html/": "/node_modules/lit-html/",
                "lit-element/lit-element.js":"/node_modules/lit-element/lit-element.js",
                "@lit/reactive-element": "/node_modules/@lit/reactive-element/reactive-element.js",
                "@lit/reactive-element/": "/node_modules/@lit/reactive-element/",
                "@lit/task":"/node_modules/@lit/task/index.js"
            }
        }
    </script>
    <script type="module" src="./ExtendableList.js" defer></script>
</head>

<body>
    <header>Konnyaku English</header>
    <div class="mainContainer">
        <h1>Hello, <%= username %>!</h1>
        <% if (userType==="teacher" ) { %>
            <a href="/lessons/createlesson" class="createLessonButton">Create A Lesson</a>
            <% } %>
                <%- include("nogrouplist", {nogroup:lessonStore.nogroup}) %>
                    <extendable-list>
                        <%- include("grouplist",lessonStore) %>
                    </extendable-list>

    </div>
    <footer>Made By Green Zombie</footer>
    <deletelesson-dialog></deletelesson-dialog>
</body>
